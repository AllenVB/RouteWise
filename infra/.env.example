# Bu dosyayı `.env` olarak kopyalayıp değerleri doldur.
#   cp infra/.env.example infra/.env
# `.env` gitignore'dadır, repoya girmez.

# ── Veritabanı ──────────────────────────────────────────────────────────────
POSTGRES_DB=routewise
POSTGRES_USER=routewise
POSTGRES_PASSWORD=degistir-beni
DB_PORT=5432

# ── OSM veri kaynağı ────────────────────────────────────────────────────────
# Geofabrik Türkiye çıkartması (~619 MB). Türkiye için alt bölge yayınlanmıyor,
# Bandırma bu dosyadan kırpılır.
OSM_SOURCE_URL=https://download.geofabrik.de/europe/turkey-latest.osm.pbf
